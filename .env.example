# Gerado automaticamente pelo setup-client.sh
# Copie para .env e preencha os valores

JWT_SECRET=seu_jwt_secret_aqui
WA_VERIFY_TOKEN=seu_verify_token_aqui

# WhatsApp Cloud API (opcional)
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
WA_ACCESS_TOKEN=
WA_DISPLAY_PHONE_NUMBER=

# Evolution API (WhatsApp Lite)
EVOLUTION_API_KEY=
EVOLUTION_API_URL=http://127.0.0.1:8080

# Meta App (Embedded Signup)
META_APP_ID=
META_APP_SECRET=
WA_EMBEDDED_CONFIG_ID=

# Servidor
PORT=3000
HOST=127.0.0.1
DATA_DIR=/root/clients/nome-do-cliente
